{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HeckTunes",
  "version": "0.2.0",
  "identifier": "com.hecktunes.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HeckTunes",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/echo-sync"],
    "resources": {
      "licenses/echo-sync-LICENSE.txt": "licenses/echo-sync-LICENSE.txt",
      "licenses/THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Music library and Echo Mini sync",
    "longDescription": "HeckTunes keeps your music library tidy (tags and album art fixed on import), manages playlists, and syncs a chosen part of it to a Snowsky Echo Mini running EchoPod."
  }
}
